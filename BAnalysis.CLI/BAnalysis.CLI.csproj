<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<AssemblyName>BAnalysis</AssemblyName>
    <ApplicationIcon>RS_lg.ico</ApplicationIcon>
    <PackageIcon>RSlogo_78x78.png</PackageIcon>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="RS_lg.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\BasList.CLI\RSlogo_78x78.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BasList.CLI\BasList.CLI.csproj" />
    <ProjectReference Include="..\BasTools.Core\BasTools.Core.csproj" />
  </ItemGroup>

</Project>
